<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ClsTester</AssemblyName>
    <RootNamespace>ClsTester</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <Description>KZTEK — Cls Tester: Phân loại bbox qua RTSP + OpenVINO</Description>
  </PropertyGroup>

  <!--
    Sdcb.OpenVINO  — inference ONNX / OpenVINO IR
    OpenCvSharp4   — capture RTSP (VideoCapture + FFMPEG)
    Microsoft.Data.Sqlite — lưu lịch sử thay đổi trạng thái
  -->
  <ItemGroup>
    <PackageReference Include="Sdcb.OpenVINO"                 Version="0.8.1" />
    <PackageReference Include="Sdcb.OpenVINO.runtime.win-x64" Version="2026.2.0" />
    <PackageReference Include="OpenCvSharp4"                  Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win"      Version="4.10.0.20241108" />
    <PackageReference Include="Microsoft.Data.Sqlite"         Version="8.0.0" />
  </ItemGroup>

</Project>
